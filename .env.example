# Digital Equb Ethiopia - Environment Configuration Example
# Copy this file to .env and configure for your target environment

# Database Configuration (PostgreSQL)
# For local socket connection:
USE_LOCAL_DB=False
DB_NAME=digital_equb_db
DB_USER=equb_admin
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Cloud PostgreSQL URL (e.g. Neon, Supabase, Cloud SQL, AWS RDS):
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Django Application Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,api.yourdomain.com

# Chapa Payment Gateway (Live credentials for Production, Test credentials for Staging)
CHAPA_SECRET_KEY=CHASECK_TEST-your-chapa-secret-key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-chapa-public-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_API_URL=https://api.chapa.co/v1
CHAPA_SANDBOX_MODE=True

# Application URLs (Frontend & Backend Base Domains)
FRONTEND_BASE_URL=https://yourdomain.com
BACKEND_BASE_URL=https://api.yourdomain.com

